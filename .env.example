# HTTP port of the application
HTTP_PORT=80
HTTPS port of the application
HTTPS_PORT=443
# Directory holding the database file (/data inside the container)
DATA_DIR=./data
# Signing secret for the session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-32-byte-hex-string-0000000000000000000000000000
# Account created on first start when the database holds no user yet.
# Leave empty to get the first-run setup screen instead.
INIT_USERNAME=
INIT_PASSWORD=
TZ=Europe/Moscow
# Public address. Left empty the app is served over plain http on port 80,
# which suits a local network. Set it to a domain name and Caddy obtains a
# certificate, renews it and redirects http to https on its own.
SITE_ADDRESS=
