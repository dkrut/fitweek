{
  "name": "fitweek",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspace web && npm run build --workspace server",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "typecheck": "npm-run-all typecheck:*",
    "db:generate": "npm run db:generate --workspace server",
    "db:snapshot": "sh scripts/copy-live-db.sh",
    "verify:live": "sh scripts/verify-live-db.sh",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^7.0.2"
  }
}
